---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import books from "../../../research/index/books.json";
import passages from "../../../research/index/passages.json";
import paulineChapters from "../../../research/index/pauline-chapters.json";
import gospelVerseCounts from "../../../research/index/gospel-verse-counts.json";
import verseCounts from "../../../research/index/pauline-verse-counts.json";
import { paulineCoverage } from "../../lib/pauline-coverage.mjs";
import decisions from "../../../research/index/pauline-extraction-dispositions.json";
import extractionQueue from "../../../research/index/teaching-extraction-queue.json";
import evidence from "../../../research/index/evidence.json";
const [comparisons, issues, reviews, topics] = await Promise.all([getCollection("comparisons"),getCollection("issues"),getCollection("reviews"),getCollection("topics")]);
const counts = (rows: {status:string}[]) => ["draft","source-checked","reviewed"].map(status => ({status,count:rows.filter(row=>row.status===status).length}));
const gospelVerseRows = paulineCoverage(gospelVerseCounts, passages);
const verseRows = paulineCoverage(verseCounts, passages);
const bookRows = books.map(book => ({...book,count:passages.filter(p=>p.bookId===book.id).length}));
const comparisonRows = comparisons.map(c=>({id:c.id,title:c.data.title,status:c.data.status,evidence:evidence.filter(e=>e.comparisonId===c.id).length,reviews:c.data.reviewIds?.length??0,issues:issues.filter(i=>i.body?.includes(`/comparisons/${c.id}/`)).length})).sort((a,b)=>a.title.localeCompare(b.title));
---
<Base title="Research coverage">
<p class="eyebrow">Research inventory</p><h1>Research coverage</h1>
<p class="lead">Live counts generated from the repository at build time. Indexed passages are selected units, not a measure of complete verse coverage.</p>
<section class="panel"><h2>Primary-text inspection</h2>
<p>The four Gospels have {extractionQueue.filter(r=>r.gospelAudit).length} passage-level inspections in the World English Bible. The thirteen Pauline letters have {decisions.filter(d=>d.primaryTextCheck).length}. Each inspection records the source and the editor’s decision about speech, action, teaching or context.</p>
<p>{passages.filter(p=>p.bookId==="ac").length} passages from Acts serve as contextual evidence. Independent scholarly review, Greek collation and evaluation of textual variants are tracked separately from English inspection.</p></section>
<section class="panel"><h2>English-text inspection by book</h2>
<p><a href="/gospel-parallels/passages/">Explore the proposed relationships between inspected Gospel passages</a></p>
<table><thead><tr><th scope="col">Book</th><th scope="col">Inspected passages</th><th scope="col">Indexed passages</th></tr></thead><tbody>
{books.filter(b => extractionQueue.some(r => r.bookId === b.id)).map(b => <tr><th scope="row"><a href={"/books/" + b.id + "/"}>{b.title}</a></th>
<td>{extractionQueue.filter(r => r.bookId === b.id && r.gospelAudit).length + decisions.filter(d => d.passageId.startsWith(b.id + "-") && d.primaryTextCheck).length}</td>
<td>{extractionQueue.filter(r => r.bookId === b.id).length}</td></tr>)}</tbody></table>
</section>
<section class="panel"><h2>Inventory</h2><p>{passages.length} passages · {comparisons.length} comparisons · {evidence.length} evidence records · {topics.length} topics · {issues.length} modern issues · {reviews.length} research reviews</p>
<h3>Evidence verification status</h3><ul>{counts(evidence).map(row=><li>{row.status}: {row.count}</li>)}</ul>
<h3>Comparison verification status</h3><ul>{counts(comparisons.map(c=>c.data)).map(row=><li>{row.status}: {row.count}</li>)}</ul></section>
<section class="panel"><h2>Pauline chapter inventory</h2><p>{paulineChapters.length} chapter summaries across thirteen letters. This is not exhaustive teaching coverage.</p><ul>{books.filter(b=>b.group.startsWith("paul-")).map(b=><li><a href={`/books/${b.id}/`}>{b.title}</a>: {paulineChapters.filter(c=>c.bookId===b.id).length} chapters; {paulineChapters.filter(c=>c.bookId===b.id && !passages.some(p=>p.bookId===b.id && Number(p.reference.match(/(\d+):\d+/)?.[1])===c.chapter)).length} chapters without selected passage records</li>)}</ul></section>
<section class="panel"><h2>Pauline verse-reference coverage</h2><p>Provisional conventional verse numbering; not independently reconciled against WEBP. Coverage measures indexed reference spans, not verified teachings.</p><p>{verseRows.reduce((s,r)=>s+r.covered,0)} of {verseRows.reduce((s,r)=>s+r.total,0)} numbered slots indexed.</p>{verseRows.map(r=><details><summary>{books.find(b=>b.id===r.bookId)?.title}: {r.covered}/{r.total} slots</summary><ul>{r.chapters.filter(c=>c.gaps.length).map(c=><li>Chapter {c.chapter}: {c.gaps.map(g=>g.start===g.end?String(g.start):g.start+"–"+g.end).join(", ")}</li>)}</ul></details>)}</section>
<section class="panel"><h2>Gospel verse-reference coverage</h2><p>Provisional conventional numbering, not verified speech coverage.</p><p>{gospelVerseRows.reduce((s,r)=>s+r.covered,0)} of {gospelVerseRows.reduce((s,r)=>s+r.total,0)} numbered slots indexed.</p>{gospelVerseRows.map(r=><details><summary>{books.find(b=>b.id===r.bookId)?.title}: {r.covered}/{r.total} slots</summary><ul>{r.chapters.filter(c=>c.gaps.length).map(c=><li>Chapter {c.chapter}: {c.gaps.map(g=>g.start===g.end?String(g.start):g.start+"–"+g.end).join(", ")}</li>)}</ul></details>)}</section>
<section class="panel"><h2>Book coverage</h2><ul>{bookRows.map(book=><li>{book.title} — {book.group}: {book.count} indexed passages</li>)}</ul></section>
<section><h2>Comparison coverage and gaps</h2><div class="card-grid">{comparisonRows.map(row=><article class="card"><h3><a href={`/comparisons/${row.id}/`}>{row.title}</a></h3><p>{row.status} · {row.evidence} evidence records · {row.reviews} linked reviews · {row.issues} linked modern issues</p>{row.evidence===0&&<p>Evidence gap</p>}{row.reviews===0&&<p>No linked focused review</p>}</article>)}</div></section>
<p class="warning">Counts do not establish historical accuracy, exhaustive coverage, or independent scholarly review.</p>
</Base>
