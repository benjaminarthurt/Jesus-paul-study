---
import Base from "../../layouts/Base.astro";
import sayings from "../../../research/index/sayings.json";
import passages from "../../../research/index/passages.json";
import books from "../../../research/index/books.json";
export function getStaticPaths() {
  return sayings.map(s => ({ params: { id: s.id }, props: { saying: s } }));
}
const { saying } = Astro.props;
const parent = passages.find(p=>p.id === saying.passageId);
const bookName = new Map(books.map(b=>[b.id,b.title]));
const sourcePrefixes: Record<string,string> = {mt:"MAT",mk:"MRK",lk:"LUK",jn:"JHN"};
const candidateChapterUrl = (p: {bookId:string,reference:string}) => {
  const chapter = Number(p.reference.match(/ (\d+):/)?.[1]);
  const prefix = sourcePrefixes[p.bookId];
  return prefix && Number.isInteger(chapter) && chapter > 0
    ? "https://ebible.org/engwebp/" + prefix + String(chapter).padStart(2,"0") + ".htm"
    : undefined;
};
---
<Base title={saying.title} description={saying.summary}>
  <div class="study">
    <p class="eyebrow">Speech-bearing passage · {saying.reference}</p>
    <h1>{saying.title}</h1>
    <p class="lead">{saying.summary}</p>
    <div class="meta kicker">
      <span class="status" data-state={saying.status}>{saying.status}</span>
      <span>{saying.speechType.replaceAll("-"," ")}</span>
      <span>Audience: {saying.audience}</span>
    </div>
    <p class="warning">This is an original paraphrase, <strong>not a quotation of Jesus</strong> or a final historical conclusion. The cited span can contain narrative or other speakers' dialogue. Review the passage itself before interpreting or applying it.</p>
    <section class="panel">
      <h2>Primary context</h2>
      <p><strong>Speech span:</strong> {saying.reference}</p>
      <p><strong>Literary unit:</strong> {parent?.reference} — {parent?.title}</p>
      <p>{parent?.summary}</p>
      <p><a href={saying.sourceUrl} rel="noopener noreferrer" target="_blank">Read {bookName.get(saying.bookId)} {saying.chapter} in {saying.sourceEdition}</a></p>
      <p><a href={`/books/${saying.bookId}/#${saying.passageId}`}>Browse the literary unit in {bookName.get(saying.bookId)}</a></p>
      <p><a href={`/passages/${saying.passageId}/`}>Source citation and related research</a></p>
    </section>
    {saying.caution && <p class="warning"><strong>Interpretive caution:</strong> {saying.caution}</p>}
    <section class="panel">
      <h2>Related research topics</h2>
      <div class="tag-list">
        {saying.topics.map(t=><a href={`/topics/${t}/`}>{t.replaceAll("-"," ")}</a>)}
      </div>
    </section>
    <section class="panel">
      <h2>Other Gospel references</h2>
      <p class="muted">Candidates for comparison, not verified identical sayings or a claim of independent sources. Relationships and wording must be checked against each Gospel's context.</p>
      {saying.parallels.length ? <ul class="parallel-list">
        {saying.parallels.map(p=><li>
          <strong>{p.reference}</strong>
          <span class="meta">{bookName.get(p.bookId)} · {p.relationship === "parallel" ? "similar narrative/saying" : "related tradition or theme"} · {p.status}</span>
          {candidateChapterUrl(p) && <a href={candidateChapterUrl(p)} target="_blank" rel="noopener noreferrer">Read candidate Gospel chapter</a>}
        </li>)}
      </ul> : <p class="muted">No parallel candidate has been recorded for this entry.</p>}
    </section>
    <p><a href="/teachings/">All recorded teaching spans</a></p>
  </div>
</Base>
