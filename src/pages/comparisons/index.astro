---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import evidence from "../../../research/index/evidence.json";
const entries = (await getCollection("comparisons")).sort((a,b) => a.data.title.localeCompare(b.data.title));
---
<Base title="Comparisons">
  <p class="eyebrow">Passage versus passage</p><h1>Comparisons</h1>
  <p class="lead">Each case tests a proposed connection or tension, including explanations that might reconcile the passages.</p>
  <p class="panel">New: <a href="/jesus-paul/">Browse the curated Jesus–Paul comparisons</a> across the seven generally undisputed letters, with agreement, tensions, counterreadings and text-specific limits.</p>
  <div class="card-grid">
    {entries.map(item => <article class="card">
      <div class="meta"><span class="status" data-state={item.data.status}>{item.data.status}</span><span>{item.data.classification.replaceAll("-"," ")}</span></div>
      <h3><a class="title-link" href={`/comparisons/${item.id}/`}>{item.data.title}</a></h3><p>{item.data.summary}</p><p class="meta">{evidence.filter(e=>e.comparisonId===item.id).length ? `${evidence.filter(e=>e.comparisonId===item.id).length} preliminary evidence claims and sourced counterreadings` : "Comparison outline; source audit pending"}</p>
    </article>)}
  </div>
</Base>
