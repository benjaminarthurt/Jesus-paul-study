---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import evidence from "../../../research/index/evidence.json";
const entries = (await getCollection("comparisons")).sort((a,b) => a.data.title.localeCompare(b.data.title));
const classifications = ["agreement", "different-emphasis", "extension", "apparent-tension", "direct-contradiction", "insufficient-evidence"] as const;
const groups = classifications.map(id => ({id, entries: entries.filter(item => item.data.classification === id)}));
---
<Base title="Comparisons">
  <p class="eyebrow">Passage versus passage</p><h1>Comparisons</h1>
  <p class="lead">Each case tests a proposed connection or tension, including explanations that might reconcile the passages.</p>
  <p class="panel">New: <a href="/jesus-paul/">Browse the curated Jesus–Paul comparisons</a> across the seven generally undisputed letters, with agreement, tensions, counterreadings and text-specific limits.</p>
  <p>{entries.length} comparisons · {entries.filter(item => item.data.status === "draft").length} drafts. Classifications are provisional, not a measure of theological truth.</p>
  <nav aria-label="Comparison classifications"><ul>{groups.map(group => <li><a href={`#${group.id}`}>{group.id.replaceAll("-", " ")} ({group.entries.length})</a></li>)}</ul></nav>
  {groups.map(group => <section class="group" id={group.id}><h2>{group.id.replaceAll("-", " ")}</h2>{group.entries.length === 0 && <p>No comparisons currently assigned to this classification.</p>}<div class="card-grid">
    {group.entries.map(item => <article class="card">
      <div class="meta"><span class="status" data-state={item.data.status}>{item.data.status}</span><span>{item.data.classification.replaceAll("-"," ")}</span></div>
      <h3><a class="title-link" href={`/comparisons/${item.id}/`}>{item.data.title}</a></h3><p>{item.data.summary}</p><p class="meta">{evidence.filter(e=>e.comparisonId===item.id).length ? `${evidence.filter(e=>e.comparisonId===item.id).length} preliminary evidence claims and counterreadings` : "Comparison outline; source audit pending"}</p>
    </article>)}
  </div></section>)}
</Base>
