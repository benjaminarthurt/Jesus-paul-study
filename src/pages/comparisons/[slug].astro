---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import passages from "../../../research/index/passages.json";
export async function getStaticPaths() {
  const entries = await getCollection("comparisons");
  return entries.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const jesusRefs = entry.data.jesus.map(id => passages.find(p => p.id === id)).filter(Boolean);
const paulRefs = entry.data.paul.map(id => passages.find(p => p.id === id)).filter(Boolean);
---
<Base title={entry.data.title} description={entry.data.summary}>
  <p class="eyebrow">Comparison · {entry.data.classification.replaceAll("-", " ")}</p>
  <h1>{entry.data.title}</h1><p class="lead">{entry.data.summary}</p>
  <div class="kicker"><span class="status" data-state={entry.data.status}>{entry.data.status}</span></div>
  <section class="split" aria-label="Passages being compared">
    <div class="panel">
      <h2>Jesus in the Gospels</h2>
      {jesusRefs.map(ref => <div class="reference"><strong>{ref.reference}</strong><span>{ref.summary}</span></div>)}
    </div>
    <div class="panel">
      <h2>Paul / writings attributed to Paul</h2>
      {paulRefs.map(ref => <div class="reference"><strong>{ref.reference}</strong><span>{ref.summary}</span><div class="meta">{ref.sourceLayer === "paul-disputed" ? "Authorship debated" : "Generally undisputed Pauline letter"}</div></div>)}
    </div>
  </section>
  <article class="prose study"><Content /></article>
  <p class="warning">Provisional classification. Both textual context and stronger counterarguments must be reviewed before any finding becomes final.</p>
  <p><a href="/comparisons/">All comparisons</a></p>
</Base>
