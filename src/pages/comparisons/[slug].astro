---
import ComparisonUnits from "../../components/ComparisonUnits.astro";
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import passages from "../../../research/index/passages.json";
import sources from "../../../research/index/sources.json";
import evidenceRows from "../../../research/index/evidence.json";
import { compareHref } from "../../lib/passage-search.mjs";
export async function getStaticPaths() {
  const entries = await getCollection("comparisons");
  return entries.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const passageById = new Map(passages.map(p => [p.id,p]));
const sourceById = new Map(sources.map(s => [s.id,s]));
const lookup = (ids: string[]) => ids.map(id => passageById.get(id)).filter(Boolean);
const jesusRefs = lookup(entry.data.jesus);
const paulRefs = lookup(entry.data.paul);
const contextRefs = lookup(entry.data.context ?? []);
const evidence = evidenceRows.filter(row => row.comparisonId === entry.id);
const citedSourceIds = entry.data.sourceIds ?? [];
const citedSources = citedSourceIds.map(id => sourceById.get(id)).filter(Boolean);
const reviewById = new Map((await getCollection("reviews")).map(review => [review.id, review]));
const relatedReviews = (entry.data.reviewIds ?? []).map((id: string) => {
  const review = reviewById.get(id);
  if (!review) throw new Error(`Comparison ${entry.id}: unknown research review ${id}`);
  return { id, title: review.body?.match(/^#\s+(.+)$/m)?.[1] ?? id };
});
import historical from "../../../research/index/historical-verification.json";
const reception = historical.filter(row => row.comparisonIds.includes(entry.id));
const relatedIssues = (await getCollection("issues")).filter(issue => issue.body?.includes(`/comparisons/${entry.id}/`)).sort((a,b) => a.data.title.localeCompare(b.data.title));
const evaluationLabels: Record<string,string> = {
  tension: "Supports a possible tension",
  agreement: "Highlights agreement",
  "interpretation-dependent": "Interpretation dependent"
};
---
<Base title={entry.data.title} description={entry.data.summary}>
  <p class="eyebrow">Comparison · {entry.data.classification.replaceAll("-", " ")}</p>
  <h1>{entry.data.title}</h1><p class="lead">{entry.data.summary}</p>
  <div class="kicker"><span class="status" data-state={entry.data.status}>{entry.data.status}</span></div>
  <p><a class="button secondary" href={compareHref(entry.data.jesus[0],entry.data.paul[0])}>Open first Gospel and Pauline references side by side</a></p>
  <section class="split" aria-label="Passages being compared">
    <div class="panel">
      <h2>Jesus in the Gospels</h2>
      {jesusRefs.map(ref => ref && <div class="reference"><strong><a href={"/passages/" + ref.id + "/"}>{ref.reference}</a></strong><span>{ref.summary}</span>{"sourceUrl" in ref && ref.sourceUrl && <p><a href={ref.sourceUrl} target="_blank" rel="noopener noreferrer">Read source chapter</a></p>}<ComparisonUnits passage={ref} /></div>)}
    </div>
    <div class="panel">
      <h2>Paul / writings attributed to Paul</h2>
      {paulRefs.map(ref => ref && <div class="reference"><strong><a href={"/passages/" + ref.id + "/"}>{ref.reference}</a></strong><span>{ref.summary}</span><div class="meta">{ref.sourceLayer === "paul-disputed" ? "Authorship debated" : "Generally undisputed Pauline letter"}</div>{"sourceUrl" in ref && ref.sourceUrl && <p><a href={ref.sourceUrl} target="_blank" rel="noopener noreferrer">Read source chapter</a></p>}{"textualNote" in ref && ref.textualNote && <p class="warning">{ref.textualNote}</p>}<ComparisonUnits passage={ref} /></div>)}
    </div>
  </section>

  {contextRefs.length > 0 && <section class="panel evidence-section">
    <h2>Contextual witnesses</h2>
    <p class="muted">These texts add background but do not become direct quotations by Jesus or Paul merely by appearing in this comparison.</p>
    {contextRefs.map(ref => ref && <div class="reference">
      <div class="meta">{ref.sourceLayer === "paul-disputed" ? "Authorship disputed — contextual witness, not uncontested Paul" : ref.sourceLayer === "acts" ? "Acts — narrative witness, not Paul\u0027s own account" : "Additional contextual witness"}</div>
      <strong><a href={"/passages/" + ref.id + "/"}>{ref.reference}</a></strong><span>{ref.summary}</span>
      {"sourceUrl" in ref && ref.sourceUrl && <p><a href={ref.sourceUrl} target="_blank" rel="noopener noreferrer">Read the passage in context</a></p>}
    </div>)}
  </section>}

  {evidence.length > 0 && <section class="evidence-section" aria-labelledby="evidence-heading">
    <p class="eyebrow">Evidence audit</p>
    <h2 id="evidence-heading">What supports each reading?</h2>
    <p class="muted">Each claim is provisional. The alternative interpretation and limitations are part of the record, not optional footnotes.</p>
    <div class="evidence-list">
      {evidence.map(row => <article class="panel evidence-item" id={row.id}>
        <div class="meta"><span class="status" data-state={row.status}>{row.status}</span><span>{evaluationLabels[row.assessment] ?? row.assessment}</span><span>· {row.kind.replaceAll("-"," ")}</span></div>
        <h3>{row.title}</h3>
        <h4>Textual or historical observation</h4>
        <p>{row.observation}</p>
        <h4>Alternative or counterreading</h4>
        <p>{row.alternateReading}</p>
        <h4>Limitations</h4>
        <p>{row.limitation}</p>
        <div class="evidence-refs">
          <strong>Passages:</strong>
          <span>{row.passageIds.map((id, i) => <>{i > 0 && " · "}<a href={`/passages/${id}/`}>{passageById.get(id)?.reference ?? id}</a></>)}</span>
        </div>
        <div class="evidence-refs">
          <strong>Sources:</strong>
          <span>{row.sourceIds.map((id,i) => <><a href={`#source-${id}`}>{sourceById.get(id)?.author ?? id}</a>{i<row.sourceIds.length-1 ? "; " : ""}</>)}</span>
        </div>
      </article>)}
    </div>
  </section>}

  <article class="prose study"><Content /></article>

  {relatedIssues.length > 0 && <section class="panel evidence-section"><h2>Modern applications</h2><p class="muted">These draft dossiers distinguish ancient evidence from contemporary inference.</p><ul>{relatedIssues.map(issue => <li><a href={`/modern-issues/${issue.id}/`}>{issue.data.title}</a></li>)}</ul></section>}

  {relatedReviews.length > 0 && <section class="panel evidence-section" aria-labelledby="related-reviews-heading">
    <h2 id="related-reviews-heading">Supporting research reviews</h2>
    <p class="muted">Working notes documenting alternative interpretations, source access and outstanding verification. These are not independently reviewed conclusions.</p>
    <ul>{relatedReviews.map(review => <li><a href={`/research-reviews/${review.id}/`}>{review.title}</a></li>)}</ul>
    <p><a href="/research-reviews/">All research reviews</a></p>
  </section>}

  {reception.length > 0 && <section class="panel evidence-section"><h2>Historical reception</h2><p>Later interpretations, not evidence of original authorial intent.</p><ul>{reception.map(row => <li><a href={`/research-reviews/${row.reviewId}/`}>{reviewById.get(row.reviewId)?.body?.match(/^#\s+(.+)$/m)?.[1] ?? row.reviewId}</a></li>)}</ul><p><a href="/historical-reception/">All historical studies</a></p></section>}
  {citedSources.length > 0 && <section aria-labelledby="source-heading" class="panel evidence-section">
    <h2 id="source-heading">Sources and access scope</h2>
    <p class="muted">The access description tells you whether the project inspected an open article or only a publisher's abstract. It does not imply peer review of this site's own conclusions.</p>
    <ol class="source-list">
      {citedSources.map(source => source && <li id={`source-${source.id}`}>
        <a href={source.url} target="_blank" rel="noopener noreferrer"><strong>{source.author}. {source.title}.</strong></a>
        <span>{source.publisher}{source.year ? ` (${source.year})` : ""}. {source.location}.</span>
        <small><strong>Inspected material:</strong> {source.accessScope.replaceAll("-"," ")}. {source.note}</small>
      </li>)}
    </ol>
  </section>}
  <p class="warning">Provisional comparison: a cited source or a readable page is not proof of a final theological or historical conclusion. Independent editorial review is required.</p>
  <p><a href="/comparisons/">All comparisons</a></p>
</Base>
