---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import sources from "../../research/index/sources.json";
import evidence from "../../research/index/evidence.json";
const issues = await getCollection("issues");
const sorted = [...sources].sort((a,b)=>a.title.localeCompare(b.title));
const accessLabels: Record<string,string> = {
  "full-text": "Full text or online article inspected",
  "publisher-abstract-only": "Publisher abstract only",
  "selected-excerpt": "Selected excerpt only"
};
const counts = new Map(sorted.map(s=>[s.id,evidence.filter(e=>e.sourceIds.includes(s.id)).length]));
---
<Base title="Sources and review">
  <p class="eyebrow">Research transparency</p>
  <h1>Sources &amp; bibliography</h1>
  <p class="lead">A traceable record of the primary Bible edition and outside scholarship used in each research pilot. Every entry specifies exactly how much source material was inspected.</p>
  <p class="warning">Having a source link does <strong>not</strong> mean a study has passed independent scholarly review. All current comparisons remain marked <strong>draft</strong>. An abstract is not the same as examining a complete monograph.</p>
  <section aria-labelledby="bibliography-heading">
    <h2 id="bibliography-heading">Cataloged sources ({sorted.length})</h2>
    <div class="card-grid">
      {sorted.map(s=><article class="card" id={`source-${s.id}`}>
        <p class="eyebrow">{s.type.replaceAll("-"," ")}</p>
        <h3><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title}</a></h3>
        <p><strong>{s.author}</strong> · {s.publisher}{s.year ? ` · ${s.year}` : ""}</p>
        <p><strong>Specific material:</strong> {s.location}</p>
        <p><strong>Access:</strong> {accessLabels[s.accessScope] ?? s.accessScope}</p>
        <p>{s.note}</p>
        <div class="meta">Cited by {counts.get(s.id)} preliminary evidence claim(s)</div>
        {issues.some(i => i.data.sourceIds?.includes(s.id)) && <ul>{issues.filter(i => i.data.sourceIds?.includes(s.id)).map(i => <li><a href={`/modern-issues/${i.id}/`}>{i.data.title}</a></li>)}</ul>}
      </article>)}
    </div>
  </section>
  <section class="study">
    <h2>Editorial status and correction policy</h2>
    <p>The source catalog is expanded alongside the studies. Research status changes from <em>draft</em> to <em>source-checked</em> only after the relevant primary texts, counterarguments, manuscript notes and scholarly sources have actually been checked. <em>Reviewed</em> requires a separate editorial pass.</p>
    <p>Corrections remain traceable in Git history; studies should state when a new reading changes a previous conclusion. Ancient descriptions, theological interpretation and modern application are tracked separately.</p>
    <p>Start with the <a href="/comparisons/law-and-faith/">Mosaic Law evidence ledger</a> for examples of a claim-by-claim analysis.</p>
  </section>
</Base>
