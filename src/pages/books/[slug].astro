---
import Base from "../../layouts/Base.astro";
import books from "../../../research/index/books.json";
import passages from "../../../research/index/passages.json";
import sayings from "../../../research/index/sayings.json";
export function getStaticPaths() {
  return books.map(book => ({ params: { slug: book.id }, props: { book } }));
}
const { book } = Astro.props;
const refs = passages.filter(p => p.bookId === book.id);
const chapterOf = (ref: { reference: string }) => Number(ref.reference.match(/(\d+):\d+/)?.[1] || 0);
const verseOf = (ref: { reference: string }) => Number(ref.reference.match(/\d+:(\d+)/)?.[1] || 0);
const mark = book.id === "mk";
const matthew = book.id === "mt";
const luke = book.id === "lk";
const pilot = mark || matthew || luke;
const chapterCount = mark ? 16 : matthew ? 28 : luke ? 24 : 0;
const sourcePrefix = mark ? "MRK" : matthew ? "MAT" : "LUK";
const visible = (mark ? refs.filter(ref => !("unitType" in ref && ref.unitType === "composite")) : refs)
  .sort((a,b) => chapterOf(a) - chapterOf(b) || verseOf(a) - verseOf(b));
const groups = pilot
  ? Array.from({length:chapterCount},(_,i)=>({chapter:i+1,records:visible.filter(ref=>chapterOf(ref)===i+1)}))
  : [];
const kindLabels: Record<string,string> = {
  speech: "Recorded speech",
  dialogue: "Encounter / dialogue",
  parable: "Parable",
  action: "Narrated action",
  context: "Context / narrative",
  prayer: "Prayer in context",
  illustration: "Teaching illustration",
  disputed: "Disputed ending",
  composite: "Composite reference"
};
---
<Base title={book.title}>
  <p class="eyebrow">Biblical book index</p>
  <h1>{book.title}</h1>
  <p class="lead">{book.attributionNote}</p>
  {pilot ? <>
    <p class="warning">This is a <strong>draft pericope map</strong>, not a complete catalog of every saying or a source-checked conclusion. Narrative events are not automatically teachings attributed to Jesus. {mark ? "Mark 16:9–20 has a disputed longer ending." : matthew ? "Matthew has a first-pass map across all 28 chapters; every speech span still needs detailed source review." : "Luke has a preliminary 24-chapter literary map, including variant cautions for Luke 22 and 23; no speech claim is independently verified."}</p>
    <nav class="chapter-nav" aria-label={`Jump to ${book.title} chapter`}>
      {groups.map(g => <a href={`#chapter-${g.chapter}`}>Chapter {g.chapter}</a>)}
    </nav>
    <p class="muted">{visible.length} passage units organized by chapter; {mark ? "The legacy Mark 7:1–23 composite anchor is omitted here to prevent duplication." : "Existing broad research anchors remain literary units, and sayings may occupy shorter spans within them."}</p>
    {groups.map(group=><section class="chapter-group" id={`chapter-${group.chapter}`}>
      <div class="chapter-heading">
        <h2>Chapter {group.chapter}</h2>
        <a href={`https://ebible.org/engwebp/${sourcePrefix}${String(group.chapter).padStart(2,"0")}.htm`} target="_blank" rel="noopener noreferrer">Read {book.title} {group.chapter} (WEBP)</a>
      </div>
      {group.records.map(ref=><article class="reference unit" id={ref.id}>
        <div class="meta">
          <strong>{ref.reference}</strong>
          {"unitType" in ref && ref.unitType && <span class="unit-label" data-kind={ref.unitType}>{kindLabels[ref.unitType] || ref.unitType}</span>}
          <span class="status" data-state={ref.status}>{ref.status}</span>
        </div>
        {"title" in ref && ref.title && <h3>{ref.title}</h3>}
        <div class="passage-actions"><a href={"/passages/" + ref.id + "/"}>Research and citations</a>{ref.sourceUrl && <a href={ref.sourceUrl} target="_blank" rel="noopener noreferrer">WEBP chapter</a>}</div>
        <p>{ref.summary}</p>
        {"textualNote" in ref && ref.textualNote && <p class="warning">{ref.textualNote}</p>}
        <div class="meta">{ref.topics.map(t => <a href={`/topics/${t}/`}>{t.replaceAll("-"," ")}</a>)}</div>
        {sayings.some(s => s.bookId === book.id && s.passageId === ref.id) && <p><a href={`/teachings/?book=${book.id}`}>Explore selected speech-bearing spans in this Gospel</a></p>}
      </article>)}
    </section>)}
  </> : <>
    <p class="warning">Coverage is developing. The references below are only an initial catalog, not an exhaustive account of this book.</p>
    <section class="study">
      <h2>Indexed passages ({visible.length})</h2>
      {visible.length ? visible.map(ref => <div class="reference" id={ref.id}>
        <strong>{ref.reference}</strong><span>{ref.summary}</span>
        <p class="passage-actions"><a href={"/passages/" + ref.id + "/"}>Research and citations</a>{ref.sourceUrl && <a href={ref.sourceUrl} target="_blank" rel="noopener noreferrer">WEBP chapter</a>}</p>
        {"textualNote" in ref && ref.textualNote && <p class="warning">{ref.textualNote}</p>}
        <p>{ref.topics.map(t => <a href={`/topics/${t}/`} style="margin-right:1rem">{t.replaceAll("-"," ")}</a>)}</p>
      </div>) : <p class="muted">Not yet cataloged. This book is on the research roadmap.</p>}
    </section>
  </>}
  <p><a href="/books/">All books</a></p>
</Base>
