---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import books from "../../research/index/books.json";
import sayings from "../../research/index/sayings.json";
const [topics, comparisons, issues] = await Promise.all([
  getCollection("topics"),
  getCollection("comparisons"),
  getCollection("issues")
]);
---
<Base title="Teachings of Jesus and Paul">
  <section class="hero">
    <p class="eyebrow">Historical · Textual · Comparative</p>
    <h1>What did Jesus teach? What did Paul teach?</h1>
    <p class="lead">An evidence-first study of their agreements, differences, and influence on modern Christianity. Read by biblical book, topic, comparison, or contemporary question.</p>
    <div class="hero-actions">
      <a href="/search/" class="button">Search all passages</a>
      <a href="/compare/" class="button secondary">Compare two passages</a>
      <a href="/gospel-parallels/" class="button secondary">Compare the four Gospels</a>
      <a href="/jesus-paul/" class="button secondary">Compare Jesus and Paul</a>
      <a href="/teachings/" class="button secondary">Browse Jesus' teachings</a>
      <a href="/methodology/" class="button secondary">Read our methodology</a>
    </div>
  </section>
  <section aria-labelledby="orientation">
    <p class="eyebrow">The project</p>
    <h2 id="orientation">Follow the evidence across sources</h2>
    <div class="card-grid">
      <article class="card"><p class="eyebrow">01 · Source texts</p><h3>Read book by book</h3><p>{books.length} canonical New Testament books are indexed, with Pauline authorship distinctions identified.</p><a href="/books/">Browse the books</a></article>
      <article class="card"><p class="eyebrow">02 · Recorded teaching</p><h3>Read Jesus' sayings</h3><p>{sayings.length} selected speech-bearing spans in Matthew, Mark, Luke, and John, linked to their original setting and provisional Gospel parallels.</p><a href="/teachings/">Browse sayings</a></article>
      <article class="card"><p class="eyebrow">03 · Teaching themes</p><h3>Compare by topic</h3><p>{topics.length} initial topic files connect Gospel passages with relevant Pauline and other texts.</p><a href="/topics/">Browse topics</a></article>
      <article class="card"><p class="eyebrow">04 · Differences and agreements</p><h3>Examine the comparison</h3><p>{comparisons.length} provisional study outlines distinguish tension from agreement and different emphasis.</p><a href="/comparisons/">Browse comparisons</a></article>
      <article class="card"><p class="eyebrow">05 · Today</p><h3>Modern issues</h3><p>{issues.length} starter dossiers distinguish ancient instruction from modern ethical or political inference.</p><a href="/modern-issues/">Browse issues</a></article>
    </div>
  </section>
  <section class="group">
    <h2>Reference tools</h2>
    <p>Search the <a href="/search/">passage index</a> or <a href="/compare/">open two passages side by side</a>, with research status, authorship categories, and source chapter links preserved.</p>
  </section>
  <section class="group">
    <h2>Research status matters</h2>
    <div class="warning">All pilot studies currently have <strong>draft</strong> status. Their descriptions are research questions and preliminary interpretations, not independently reviewed conclusions.</div>
  </section>
</Base>
