---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import books from "../../research/index/books.json";
const [topics, comparisons, issues] = await Promise.all([
  getCollection("topics"),
  getCollection("comparisons"),
  getCollection("issues")
]);
---
<Base title="Teachings of Jesus and Paul">
  <section class="hero">
    <p class="eyebrow">Historical · Textual · Comparative</p>
    <h1>What did Jesus teach? What did Paul teach?</h1>
    <p class="lead">An evidence-first study of their agreements, differences, and influence on modern Christianity. Read by biblical book, topic, comparison, or contemporary question.</p>
    <div class="hero-actions">
      <a href="/topics/" class="button">Explore the topics</a>
      <a href="/methodology/" class="button secondary">Read our methodology</a>
    </div>
  </section>
  <section aria-labelledby="orientation">
    <p class="eyebrow">The project</p>
    <h2 id="orientation">Follow the evidence across sources</h2>
    <div class="card-grid">
      <article class="card"><p class="eyebrow">01 · Source texts</p><h3>Read book by book</h3><p>{books.length} canonical New Testament books are indexed, with Pauline authorship distinctions identified.</p><a href="/books/">Browse the books</a></article>
      <article class="card"><p class="eyebrow">02 · Teaching themes</p><h3>Compare by topic</h3><p>{topics.length} initial topic files connect Gospel passages with relevant Pauline and other texts.</p><a href="/topics/">Browse topics</a></article>
      <article class="card"><p class="eyebrow">03 · Differences and agreements</p><h3>Examine the comparison</h3><p>{comparisons.length} provisional study outlines distinguish tension from agreement and different emphasis.</p><a href="/comparisons/">Browse comparisons</a></article>
      <article class="card"><p class="eyebrow">04 · Today</p><h3>Modern issues</h3><p>{issues.length} starter dossiers distinguish ancient instruction from modern ethical or political inference.</p><a href="/modern-issues/">Browse issues</a></article>
    </div>
  </section>
  <section class="group">
    <h2>Research status matters</h2>
    <div class="warning">All pilot studies currently have <strong>draft</strong> status. Their descriptions are research questions and preliminary interpretations, not independently reviewed conclusions.</div>
  </section>
</Base>
