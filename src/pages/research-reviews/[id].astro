---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
export async function getStaticPaths() {
  return (await getCollection("reviews")).map((review) => ({
    params: { id: review.id }, props: { review }
  }));
}
import historical from "../../../research/index/historical-verification.json";
const { review } = Astro.props;
const historicalRecord = historical.find(row => row.reviewId === review.id);
const relatedComparisons = (await getCollection("comparisons")).filter(entry => entry.data.reviewIds?.includes(review.id) || historicalRecord?.comparisonIds.includes(entry.id));
const { Content } = await render(review);
const title = review.body?.match(/^#\s+(.+)$/m)?.[1] ?? review.id;
---
<Base title={title}>
  <p><a href="/research-reviews/">Back to research review ledger</a></p>
  <div class="warning"><strong>Draft research:</strong> This working note is not an independently verified conclusion. Consult its source limitations and verification requirements.</div>
  {historicalRecord && <section class="panel"><h2>Historical reception</h2><p>Recorded excerpt audit: {historicalRecord.verification.replaceAll("-", " ")}. Full scholarly verification remains pending.</p><p><a href="/historical-reception/">Historical reception index</a></p></section>}
  <article class="group"><Content /></article>
  <section class="panel evidence-section" aria-labelledby="related-comparisons">
    <h2 id="related-comparisons">Related comparisons</h2>
    {relatedComparisons.length > 0 ? <ul>{relatedComparisons.map(entry => <li><a href={`/comparisons/${entry.id}/`}>{entry.data.title}</a></li>)}</ul> : <p>This review is not yet assigned to a specific comparison.</p>}
    <p><a href="/comparisons/">Browse all comparisons</a></p>
  </section>
</Base>
